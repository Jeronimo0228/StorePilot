{
  "name": "storepilot-mcp",
  "version": "1.1.2",
  "description": "StorePilot — MCP release orchestration for App Store Connect and Google Play (snapshot, blockers, dry-run intents)",
  "license": "MIT",
  "author": "Jerónimo Restrepo <jrestrepoa@eafit.edu.co>",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/ARCHITECTURE.md",
    "docs/CREDENTIALS.md",
    "docs/PUBLISHING.md",
    "docs/SECURITY.md",
    "docs/TOOLS.md",
    "docs/TOOLSETS.md",
    "docs/COMPARISON.md",
    "docs/GAP_ANALYSIS.md",
    "docs/DEMO.md",
    "docs/LAUNCH.md",
    "storepilot.example.yaml",
    ".env.example"
  ],
  "overrides": {
    "gaxios": "7.3.0"
  },
  "bin": {
    "storepilot-mcp": "dist/index.js",
    "storepilot": "dist/cli.js",
    "mobile-release-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "smoke": "node --import tsx scripts/smoke-tools.ts",
    "snapshot": "node --import tsx scripts/live-snapshot.ts",
    "storepilot": "node --import tsx src/cli.ts",
    "demo": "npm run build && bash scripts/demo-storepilot.sh",
    "try": "npm run build && bash scripts/try-storepilot.sh",
    "record:console:4k": "bash scripts/build-console-demo-4k.sh",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "app-store-connect",
    "google-play",
    "mobile",
    "release",
    "ios",
    "android",
    "testflight",
    "expo",
    "eas",
    "cursor",
    "claude",
    "storepilot",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeronimo0228/StorePilot.git"
  },
  "homepage": "https://github.com/Jeronimo0228/StorePilot#readme",
  "bugs": {
    "url": "https://github.com/Jeronimo0228/StorePilot/issues"
  },
  "dependencies": {
    "@googleapis/androidpublisher": "^38.0.0",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "googleapis-common": "^9.0.4",
    "hono": "^4.7.0",
    "jsonwebtoken": "^9.0.2",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.1.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
