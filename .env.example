# Apple App Store Connect
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY_PATH=
# Or provide the key content directly (base64 encoded)
APPLE_PRIVATE_KEY_BASE64=

# Google Play Console
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
# Or provide the key content directly (JSON string)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Webhooks
WEBHOOK_PORT=3000
EAS_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
# Persist webhook events to disk (survives restarts)
WEBHOOK_STORAGE_PATH=.data/webhooks.json
# Require webhook secrets when HTTP/webhook endpoints are enabled (default: true)
WEBHOOK_REQUIRE_SECRETS=true

# MCP Transport
# stdio = local MCP clients (Cursor, Claude Desktop)
# http = remote deployment with /mcp endpoint
MCP_TRANSPORT=stdio
MCP_PORT=3000
# Required in HTTP mode (min 32 chars). Generate: openssl rand -base64 48
MCP_HTTP_API_KEY=
# Optional comma-separated browser origins for CORS (disabled if empty)
MCP_ALLOWED_ORIGINS=

# Reduce tool surface for agents (all | release | readonly)
MCP_TOOLSET=all

# Multi-project registry (use several apps in one MCP process)
# Option A — JSON array or comma-separated paths to storepilot.yaml files:
# STOREPILOT_PROJECTS=["/apps/plazario/storepilot.yaml","/apps/other/storepilot.yaml"]
# STOREPILOT_PROJECTS=/apps/plazario/storepilot.yaml,/apps/other/storepilot.yaml
# Option B — directory of project folders (each with storepilot.yaml):
# STOREPILOT_PROJECTS_DIR=/home/you/.config/storepilot/projects
# Default single-project pointer (also registered):
# STOREPILOT_CONFIG_PATH=/path/to/app/storepilot.yaml
# Agents call select_project("plazario") or pass project: "plazario" on any tool.

# Map EAS project names to store identifiers for webhook automation
# EAS_PROJECT_MAPPINGS=[{"projectName":"my-app","iosAppId":"1234567890","androidPackageName":"com.example.app"}]

# Logging (debug | info | warn | error)
LOG_LEVEL=info
